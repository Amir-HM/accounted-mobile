{
  "expo": {
    "name": "Accounted",
    "slug": "accounted-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "accountedmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.deuslabs.accountedmobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deuslabs.accountedmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f3f1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Accounted uses the camera to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Accounted lets you choose receipt photos from your library.",
          "cameraPermission": "Accounted uses the camera to scan receipts.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "amirhm",
    "extra": {
      "eas": {
        "projectId": "0025b398-a363-45ef-b3c4-59831e8f6968"
      },
      "defaultServer": "accounted.deus-labs.com"
    }
  }
}
